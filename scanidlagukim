--[[
	==========================================================
	 NOW PLAYING - CLIENT ONLY (1 LocalScript, no server)
	==========================================================
	Letakkan di: StarterPlayer > StarterPlayerScripts > LocalScript
	(atau StarterCharacterScripts kalau mau reset tiap respawn)

	Semua jalan di sisi client:
	- Scan semua objek Sound yang sudah direplikasi ke player ini
	- Deteksi mana yang sedang diputar (IsPlaying == true)
	- Ambil Asset ID dari SoundId ("rbxassetid://123456" -> 123456)
	- Coba ambil nama lagu (MarketplaceService:GetProductInfo) + tabel nama manual
	- Tampilkan panel "Now Playing" + tombol Copy ID
	- Print ke Output juga

	TIDAK butuh HttpService / RemoteEvent / ModuleScript.

	Catatan: HttpService TIDAK bisa dipakai di LocalScript, jadi nama lagu
	diambil dari GetProductInfo + tabel KnownNames yang bisa kamu isi sendiri.
]]

local Players = game:GetService("Players")
local MarketplaceService = game:GetService("MarketplaceService")
local SoundService = game:GetService("SoundService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ReplicatedFirst = game:GetService("ReplicatedFirst")

local player = Players.LocalPlayer

--==========================================================
-- KONFIGURASI
--==========================================================
local CONFIG = {
	PollInterval = 0.5,       -- seberapa sering cek (detik)
	MinTimeLength = 5,        -- abaikan sound lebih pendek dari ini (detik). 0 = matikan
	OnlySoundGroupName = nil, -- mis. "Music" kalau map pakai SoundGroup
	PlayStrategy = "latest",  -- "latest" | "loudest" | "longest"

	IgnoreNames = { Click = true, Hover = true, ButtonClick = true, Tick = true },

	ShowGui = true,                          -- false = cuma print ke Output
	ToggleKey = Enum.KeyCode.RightShift,     -- sembunyikan/tampilkan panel
	ShowAllPlaying = true,                   -- print juga sound lain yang ikut bunyi

	ResolveNames = true,                     -- coba ambil nama via GetProductInfo
	RescanEvery = 60,                        -- full scan ulang tiap N poll (jaring pengaman)
}

-- Isi manual kalau nama dari GetProductInfo kosong/salah, contoh:
-- [1834567890] = "Golden Hour - JVKE",
local KnownNames = {
	-- [1234567890] = "Judul Lagu",
}

--==========================================================
-- API KECIL UNTUK KODE KAMU
--==========================================================
local listeners = {}
local NowPlaying = {
	current = nil, -- { assetId, name, soundName, path, volume, timeLength, timePosition }
}

-- Cara pakai:
--   NowPlaying.Changed:Connect(function(info) print(info.assetId, info.name) end)
--   print(NowPlaying:GetCurrentAssetId())
NowPlaying.Changed = {
	Connect = function(_, fn)
		listeners[#listeners + 1] = fn
		return {
			Disconnect = function()
				for i = #listeners, 1, -1 do
					if listeners[i] == fn then
						table.remove(listeners, i)
					end
				end
			end,
		}
	end,
}

function NowPlaying:GetCurrent()
	return self.current
end

function NowPlaying:GetCurrentAssetId()
	return self.current and self.current.assetId or nil
end

function NowPlaying:GetCurrentSoundId()
	local id = NowPlaying:GetCurrentAssetId()
	return id and ("rbxassetid://" .. id) or nil
end

_G.NowPlaying = NowPlaying -- biar bisa diakses dari script lain di client yang sama

--==========================================================
-- UTIL
--==========================================================
local function extractAssetId(soundId)
	if type(soundId) ~= "string" then
		return nil
	end
	local id = string.match(soundId, "rbxassetid://(%d+)")
		or string.match(soundId, "[?&]id=(%d+)")
		or string.match(soundId, "^%s*(%d+)%s*$")
	return id and tonumber(id) or nil
end

local function isPlaying(sound)
	local ok, value = pcall(function()
		return sound.IsPlaying
	end)
	return ok and value == true
end

local function isCandidate(sound)
	if not sound:IsA("Sound") then
		return false
	end
	if CONFIG.IgnoreNames[sound.Name] then
		return false
	end
	if CONFIG.OnlySoundGroupName then
		local group = sound.SoundGroup
		if not group or group.Name ~= CONFIG.OnlySoundGroupName then
			return false
		end
	end
	if extractAssetId(sound.SoundId) == nil then
		return false
	end
	if CONFIG.MinTimeLength > 0 then
		local ok, length = pcall(function()
			return sound.TimeLength
		end)
		if ok and length > 0 and length < CONFIG.MinTimeLength then
			return false
		end
	end
	return true
end

local function getScanRoots()
	local roots = { Workspace, SoundService, Lighting, ReplicatedStorage, ReplicatedFirst }
	if player then
		local playerGui = player:FindFirstChildOfClass("PlayerGui")
		if playerGui then
			table.insert(roots, playerGui)
		end
	end
	return roots
end

--==========================================================
-- NAMA LAGU
--==========================================================
local nameCache = {}
local pendingNames = {}

local function requestName(assetId, callback)
	if not assetId then
		return
	end

	if KnownNames[assetId] then
		nameCache[assetId] = KnownNames[assetId]
	end
	if nameCache[assetId] then
		callback(nameCache[assetId])
		return
	end

	if not CONFIG.ResolveNames or pendingNames[assetId] then
		return
	end
	pendingNames[assetId] = true

	task.spawn(function()
		local ok, info = pcall(function()
			return MarketplaceService:GetProductInfo(assetId, Enum.InfoType.Asset)
		end)
		pendingNames[assetId] = nil

		if ok and type(info) == "table" and type(info.Name) == "string" and info.Name ~= "" then
			nameCache[assetId] = info.Name
			callback(info.Name)
		end
	end)
end

--==========================================================
-- REGISTRI SOUND (biar nggak scan GetDescendants tiap 0.5 detik)
--==========================================================
local registry = {} -- [Sound] = true

local function addSound(sound)
	if registry[sound] or not sound:IsA("Sound") then
		return
	end
	registry[sound] = true
	sound.Destroying:Connect(function()
		registry[sound] = nil
	end)
end

local function fullScan()
	for _, root in ipairs(getScanRoots()) do
		for _, descendant in ipairs(root:GetDescendants()) do
			if descendant:IsA("Sound") then
				addSound(descendant)
			end
		end
	end
end

local function hookRoots()
	for _, root in ipairs(getScanRoots()) do
		root.DescendantAdded:Connect(function(descendant)
			if descendant:IsA("Sound") then
				addSound(descendant)
			end
		end)
	end
end

