local function formatTime(seconds)
	seconds = math.max(0, math.floor(seconds or 0))
	return string.format("%d:%02d", math.floor(seconds / 60), seconds % 60)
end

local function render(info)
	if not CONFIG.ShowGui or not panel then
		return
	end

	if info and info.assetId then
		panel.Visible = gui.Enabled
		titleLabel.Text = info.name or info.soundName or "Lagu tanpa nama"
		idBox.Text = "rbxassetid://" .. tostring(info.assetId)
		if info.timeLength and info.timeLength > 0 then
			metaLabel.Text = formatTime(info.timePosition) .. " / " .. formatTime(info.timeLength)
		else
			metaLabel.Text = ""
		end
	else
		panel.Visible = false
	end
end

--==========================================================
-- POLLING
--==========================================================
local startTick = 0
local wasPlaying = {}  -- [Sound] = true
local startTicks = {}  -- [Sound] = tick saat mulai diputar

local function makeSnapshot(sound, entry)
	local volume, length, position = 0, 0, 0
	pcall(function()
		volume = sound.Volume
		length = sound.TimeLength
		position = sound.TimePosition
	end)
	return {
		assetId = entry.assetId,
		name = nameCache[entry.assetId] or KnownNames[entry.assetId],
		soundName = sound.Name,
		path = sound:GetFullName(),
		volume = volume,
		timeLength = length,
		timePosition = position,
		sound = sound,
	}
end

local current = nil
local lastPrintedId = nil

local function poll()
	startTick = startTick + 1

	local active = {}

	for sound in pairs(registry) do
		if sound.Parent == nil then
			registry[sound] = nil
			wasPlaying[sound] = nil
			startTicks[sound] = nil
		else
			local playing = isPlaying(sound)
			if playing and not wasPlaying[sound] then
				wasPlaying[sound] = true
				startTicks[sound] = startTick
			elseif not playing then
				wasPlaying[sound] = false
			end

			if playing and isCandidate(sound) then
				local assetId = extractAssetId(sound.SoundId)
				if assetId then
					local entry = { assetId = assetId }

					-- minta nama kalau belum ada (sekali per ID)
					if CONFIG.ResolveNames and not nameCache[assetId] then
						requestName(assetId, function(name)
							-- update tampilan kalau lagu ini masih yang aktif
							if current and current.assetId == assetId then
								current.name = name
								render(current)
							end
						end)
					end

					local snapshot = makeSnapshot(sound, entry)
					local tickValue = startTicks[sound] or 0

					active[#active + 1] = { snapshot = snapshot, tick = tickValue }
				end
			end
		end
	end

	-- pilih lagu utama
	local best, bestScore = nil, -math.huge
	for _, item in ipairs(active) do
		local score
		if CONFIG.PlayStrategy == "loudest" then
			score = item.snapshot.volume
		elseif CONFIG.PlayStrategy == "longest" then
			score = item.snapshot.timeLength
		else
			score = item.tick
		end
		if score > bestScore then
			best, bestScore = item, score
		end
	end

	local chosen = best and best.snapshot or nil
	local sameAsBefore = current
		and chosen
		and current.sound == chosen.sound
		and current.assetId == chosen.assetId

	if not sameAsBefore then
		current = chosen
		NowPlaying.current = chosen

		render(chosen)

		-- print ke Output
		if chosen then
			if chosen.assetId ~= lastPrintedId then
				lastPrintedId = chosen.assetId
				print(string.format(
					"[NowPlaying] %s | ID: %d | rbxassetid://%d | %s",
					chosen.name or "(nama belum diketahui)",
					chosen.assetId,
					chosen.assetId,
					chosen.path
				))
				if CONFIG.ShowAllPlaying then
					for i, item in ipairs(active) do
						if item.snapshot.sound ~= chosen.sound then
							print(string.format(
								"             + juga berbunyi: %s (ID: %d)",
								item.snapshot.name or item.snapshot.soundName,
								item.snapshot.assetId
							))
						end
					end
				end
			end
		else
			lastPrintedId = nil
			print("[NowPlaying] Tidak ada lagu yang diputar.")
		end

		for _, fn in ipairs(listeners) do
			pcall(fn, chosen)
		end
	end
end

--==========================================================
-- START
--==========================================================
if CONFIG.ShowGui then
	task.spawn(buildGui)
end

fullScan()
hookRoots()

task.spawn(function()
	local counter = 0
	while true do
		counter = counter + 1
		if counter % math.max(1, CONFIG.RescanEvery) == 0 then
			fullScan()
		end
		local ok, err = pcall(poll)
		if not ok then
			warn("[NowPlaying] poll error: " .. tostring(err))
		end
		task.wait(CONFIG.PollInterval)
	end
end)

-- Toggle panel
UserInputService.InputBegan:Connect(function(input, processed)
	if processed or not CONFIG.ShowGui or not gui then
		return
	end
	if input.KeyCode == CONFIG.ToggleKey then
		if gui.Enabled then
			gui.Enabled = false
		else
			gui.Enabled = true
			render(current)
		end
	end
end)

